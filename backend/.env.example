# SpriteForge Backend — .env.example
# Copy this to .env and fill in real values.
# NEVER commit .env to git.

# ── Provider selection ─────────────────────────────────────────
PROVIDER=cloudflare
FALLBACK_PROVIDER=local_cpu
PROVIDER_TIMEOUT_S=120
PROVIDER_MAX_RETRIES=3

# ── Option A: Cloudflare Workers AI ───────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
CF_MODEL_ID=@cf/black-forest-labs/flux-1-schnell
CF_STEPS=4

# ── Option B: Local CPU (SD-Turbo via OpenVINO) ───────────────
LOCAL_MODEL_ID=stabilityai/sd-turbo
LOCAL_MODEL_DIR=../models/sd-turbo-ov
LOCAL_STEPS=1

# ── Option C: HuggingFace (paid) ──────────────────────────────
# HF_TOKEN=hf_your_token_here
# HF_MODEL_ID=black-forest-labs/FLUX.1-schnell
# HF_API_URL=https://api-inference.huggingface.co/models/black-forest-labs/FLUX.1-schnell

# ── Option D: Google Gemini ───────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-image

# ── Asset & image processing ──────────────────────────────────
ASSET_DIR=../assets/sprites
REMBG_MODEL=u2net
ALPHA_THRESHOLD=16
CELL_SIZE=0
MAX_IMAGE_BYTES=10485760
MAX_TEXTURE_SIZE=4096

# ── Job queue ─────────────────────────────────────────────────
JOB_WORKERS=1
MAX_QUEUED_JOBS=5
JOB_TTL_MIN=60
RATE_LIMIT_PER_MIN=6

# ── Flask ──────────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change_me_to_a_random_64_char_hex_string

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
